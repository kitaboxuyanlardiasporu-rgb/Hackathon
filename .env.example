# Bu faylı ".env" adı ilə kopyalayın və dəyərləri dəyişin.

# Verilənlər bazasının parolu (uzun, təsadüfi)
POSTGRES_PASSWORD=burani-deyisin-uzun-tesadufi-parol

# İlkin admin: YALNIZ bazada heç bir admin olmadıqda istifadə olunur.
# Portal ilk dəfə işə düşdükdən sonra bu iki sətri silə bilərsiniz.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=burani-deyisin-en-azi-8-simvol

# auto: HTTPS ilə açıldıqda cookie Secure olur (tövsiyə olunur)
COOKIE_SECURE=auto

# Portalın açılacağı port
PORT=8000
